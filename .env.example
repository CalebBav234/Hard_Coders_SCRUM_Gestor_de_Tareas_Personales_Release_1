# Copiar como .env solo cuando el backend lo necesite. No subir .env a Git.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestor_tareas
DB_SCHEMA=task_manager

# Usuario de la aplicación: solo lectura/escritura de datos.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gestor_tareas?currentSchema=task_manager
SPRING_DATASOURCE_USERNAME=gestor_tareas_app
SPRING_DATASOURCE_PASSWORD=REEMPLAZAR_LOCALMENTE

# La estructura la administra el responsable de datos mediante database/scripts.
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_PROPERTIES_HIBERNATE_JDBC_TIME_ZONE=UTC
